            android:paddingBottom="2.5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/period8_tag"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="P8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0D7377"
                android:gravity="center"
                android:background="@drawable/widget_period_badge"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/period8_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Subject 8"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_no_periods"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No periods scheduled today"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_btn_take_roll"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="Take Roll Call"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>