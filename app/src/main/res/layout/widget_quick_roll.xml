                android:textSize="11sp"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/period8_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
