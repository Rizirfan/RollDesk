                android:textSize="11sp"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/period6_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/period6_tag"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="P6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0D7377"
                android:gravity="center"
                android:background="@drawable/widget_period_badge"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/period6_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Subject 6"
                android:textSize="11sp"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/period7_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/period7_tag"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="P7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0D7377"
                android:gravity="center"
                android:background="@drawable/widget_period_badge"
                android:paddingTop="1dp"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/period7_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
